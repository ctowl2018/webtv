<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 系统 SplashScreen 的图标槽位：
  系统只能在这个方形槽位里画一个图标，放不下横向的「图标 + 影视 Videos」品牌组合，
  因此这里放一个透明块把图标藏起来，只保留纯色底；
  组合标由 HomeActivity 的闪屏层绘制（与底色一致、首帧即出现）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#00000000" />
    <size
        android:width="1dp"
        android:height="1dp" />

</shape>
