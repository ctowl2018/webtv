<?xml version="1.0" encoding="utf-8"?>
<!--
  进度条聚焦光带：垫在 DefaultTimeBar 轨道下方的圆角条，高度由 CustomSeekView 按 10dp 摆放，
  只在进度条拿到焦点时淡入。用“加一条更厚的底色”来表达聚焦放大，避免直接缩放控件——
  DefaultTimeBar 的滑块是画在内部的正圆，纵向缩放会把它拉成椭圆。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="5dp" />

    <solid android:color="@color/control_focus_glow" />
</shape>
