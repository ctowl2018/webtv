<?xml version="1.0" encoding="utf-8"?>
<!-- 切换源面板的站点格子：默认态与「播放设置」按钮同一块半透明白底 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#1FFFFFFF" />

    <corners android:radius="6dp" />

    <padding
        android:bottom="8dp"
        android:left="10dp"
        android:right="10dp"
        android:top="8dp" />

</shape>
