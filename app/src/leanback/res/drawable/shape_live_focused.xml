<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点态：半透明白色块（@color/focus_block），不再使用描边线框 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/focus_block" />

    <corners android:radius="4dp" />

    <padding
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />

</shape>