<?xml version="1.0" encoding="utf-8"?>
<!--
  选集菜单背景：四角圆角的暗色玻璃，浮在播放画面上。
  与底部弹窗（shape_dialog_glass）的区别：那个下沿直角贴屏幕底边，这个四面都要圆角；
  不透明度也比底部弹窗高一档（90% vs 70%）—— 体量小、直接压在画面上，太透会看不清边界。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:endColor="#E60E1116"
        android:startColor="#E61A2029"
        android:type="linear" />

    <corners android:radius="14dp" />

    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />

</shape>
