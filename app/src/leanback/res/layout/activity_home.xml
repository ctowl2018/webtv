<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="6dp">

            <!--
              品牌组合「图标 + 影视 Videos」：整个组合是一个焦点单元，
              承接原先挂在源名称标题上的焦点（点击弹源列表、长按重载配置、上键刷新）。
            -->
            <com.fongmi.android.tv.ui.custom.CustomLogoBar
                android:id="@+id/logoBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/typeRecycler"
                android:orientation="horizontal"
                android:paddingEnd="5dp">

                <!-- 组合标尺寸为原 53dp/25dp 的 80%（42/20dp），与右侧图标组的高度比例保持协调 -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/logo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/logoWord"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_marginStart="8dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_word" />

            </com.fongmi.android.tv.ui.custom.CustomLogoBar>

            <!-- 源名称：字号随组合标一起缩到 16sp（原 20sp），避免字比 logo 还抢眼 -->
            <com.fongmi.android.tv.ui.custom.CustomTitleView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@id/typeRecycler"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/home_source_name"
                android:textSize="14sp" />

            <!-- 搜索 / 收藏 / 设置：仅保留图标，紧贴时钟左侧，整组与时钟垂直居中对齐 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnSearch"
                style="@style/HomeToolbarIcon"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/home_search"
                android:nextFocusDown="@id/typeRecycler"
                android:src="@drawable/ic_toolbar_search" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnKeep"
                style="@style/HomeToolbarIcon"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/home_keep"
                android:nextFocusDown="@id/typeRecycler"
                android:src="@drawable/ic_toolbar_star" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnSetting"
                style="@style/HomeToolbarIcon"
                android:contentDescription="@string/home_setting"
                android:nextFocusDown="@id/typeRecycler"
                android:src="@drawable/ic_toolbar_setting" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-black"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="09:20" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!--
          分类行：整行就是这一个 HorizontalGridView 容器，「首页」作为适配器第一项与分类标签同排，
          间距、行高、胶囊样式统一由容器与 TypeAdapter 决定（16dp 间隔），不再单独放一个固定按钮。
        -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/typeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="2dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/typeRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusUp="@id/logoBar"
                android:nextFocusDown="@id/recycler"
                app:focusOutEnd="false"
                app:focusOutFront="true"
                tools:visibility="visible" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusUp="@id/typeRecycler"
                android:paddingStart="24dp"
                android:paddingTop="3dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                app:focusOutEnd="true"
                app:focusOutFront="true" />

        </com.fongmi.android.tv.ui.custom.ProgressLayout>

        <!--
          分页容器：第 0 页是「首页」页（progressLayout 运行时移交给 HomePageFragment 挂载），
          第 1..N 页是各分类（FolderFragment），与分类页沿用同一套切换方式。
          两侧边界由 ViewPager 天然限制：首页之前 / 末页之后都滑不动。
          平时 progressLayout 已被摘走，这里只剩 pager 占满剩余高度。
        -->
        <com.fongmi.android.tv.ui.custom.CustomViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!--
      启动闪屏：Android 12+ 的系统 SplashScreen 只能显示一个方图标，
      放不下横向的「图标 + 影视 Videos」，因此系统层只保留同色底，
      组合标在这里绘制，首帧后淡出，与系统启动窗口无缝衔接。

      横向组合标（方案 L1）：[三角 53dp][12dp][字标 25dp]   3dp×25dp 竖线   万象清音 一屏尽览   All in One Screen
      · 图标与字标沿用标题栏那套尺寸（53dp + 12dp + 25dp），字标在 53dp 高度里垂直居中；
      · 竖线高度 = 字标高度（25dp），上下沿与字标齐平；slogan 与字标**底边对齐**（不居中），
        因此整行用 gravity=bottom，竖线与文字各自用 marginBottom 把底边抬到字标底边；
      · 中英同字号 13sp、sans-serif-black（类黑体 / Arial Black 的等效字重），英文只降透明度；
      · 整组在闪屏里居中，闪屏淡出后露出标题栏同款组合标，品牌元素不“换形状”。
    -->
    <FrameLayout
        android:id="@+id/splashLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/startup_background"
        android:clickable="true"
        android:focusable="false">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="53dp"
            android:layout_gravity="center"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- 品牌组合：图标 53dp + 间距 12dp + 字标 25dp（字标在图标高度内垂直居中） -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="53dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/splashLogo"
                    android:layout_width="53dp"
                    android:layout_height="53dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logo" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/splashWord"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginStart="12dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_word" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 风格线：3dp × 25dp（= 字标高度），与字标上下沿齐平 -->
            <View
                android:id="@+id/splashDivider"
                android:layout_width="3dp"
                android:layout_height="25dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="14dp"
                android:background="#8CFFFFFF" />

            <!-- 中文 slogan：与字标底边同一基线 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/splash_slogan_cn"
                android:textColor="#F4FFFFFF"
                android:textSize="13sp" />

            <!-- 英文 slogan：同字号；Arial Black 的等效字重，透明度低一档做层级 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/splash_slogan_en"
                android:textColor="#C8FFFFFF"
                android:textSize="13sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

</FrameLayout>
