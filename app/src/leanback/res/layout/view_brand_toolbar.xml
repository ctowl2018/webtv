<?xml version="1.0" encoding="utf-8"?>
<!--
  共用品牌工具栏：分类页、搜索页、搜索结果页、播放详情页顶部复用同一份布局，
  尺寸/位置/风格与首页标题栏完全一致（见 activity_home.xml 的 toolbar）：
    · 左上边距 24dp/24dp，图标 42dp + 10dp 间隔 + 20dp 字标（原 53/12/25 的 80%）
    · 右侧依次是搜索 / 收藏 / 设置三个图标入口（40dp 槽位、8dp 内边距）与 24sp 时钟，时钟左间距 14dp
    · 与首页的唯一差别：这里的组合标不参与焦点、不弹源列表（无源切换功能），仅作品牌展示。

  这些页面没有源名称，因此用弹性占位（Space weight=1）把右侧那组推到行尾对齐，
  与首页“源名称占满中间”的排布结果完全一致。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="6dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brandLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brandWord"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginStart="8dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_word" />

    <!--
      中间文字位：与首页「源名称」完全同一套规范（14dp 左间距、16sp、@color/home_source_name、
      单行 marquee、不参与焦点），占用中间全部剩余宽度并把右侧三个入口 + 时钟推到行尾。
      默认 INVISIBLE —— 仍然参与测量，所以占位效果等价于弹性留白；
      搜索结果页把「“xx”的搜索结果」写进这里，视觉位置与首页源名称逐像素一致。
    -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/brandTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:singleLine="true"
        android:textColor="@color/home_source_name"
        android:textSize="14sp"
        android:visibility="invisible"
        tools:text="“庆余年”的搜索结果"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brandSearch"
        style="@style/HomeToolbarIcon"
        android:layout_marginEnd="2dp"
        android:contentDescription="@string/home_search"
        android:src="@drawable/ic_toolbar_search" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brandKeep"
        style="@style/HomeToolbarIcon"
        android:layout_marginEnd="2dp"
        android:contentDescription="@string/home_keep"
        android:src="@drawable/ic_toolbar_star" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brandSetting"
        style="@style/HomeToolbarIcon"
        android:contentDescription="@string/home_setting"
        android:src="@drawable/ic_toolbar_setting" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/brandClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-black"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/white"
        android:textSize="20sp"
        tools:text="09:20" />

</androidx.appcompat.widget.LinearLayoutCompat>
